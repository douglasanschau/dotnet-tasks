@model  RegistroViewModel 

<link rel="stylesheet" href="/css/login.css" asp-append-version="true"  />

<div class="container">
    <form method="post" asp-controller="Usuario" asp-action="Registro" class="form-login">

        <div asp-validation-summary="All" class="text-danger"></div>

        <h2>Cadastro Dotnet</h2>

        <div class="form-group">
            <label asp-for="Nome">Nome</label>
            <input asp-for="Nome" type="text" placeholder="Digite seu nome" />
        </div>

        <div class="form-group">
            <label asp-for="Email">E-mail</label>
            <input asp-for="Email" type="email" placeholder="Digite seu e-mail" />
        </div>

        <div class="form-group">
            <label asp-for="Senha">Senha</label>
            <input asp-for="Senha" type="password" placeholder="Digite sua senha" />
        </div>

        <button type="submit">Cadastrar</button>
    </form>
</div>