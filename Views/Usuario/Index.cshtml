@model  LoginViewModel 

<link rel="stylesheet" href="/css/login.css" asp-append-version="true"  />


<div class="container">
    <form method="post" asp-controller="Usuario" asp-action="Login" class="form-login">

        <div asp-validation-summary="All" class="text-danger"></div>

        <h2>Tarefas Dotnet</h2>

        <div class="form-group">
            <label asp-for="Email">E-mail</label>
            <input asp-for="Email" type="email" placeholder="Digite seu e-mail" />
        </div>

        <div class="form-group">
            <label asp-for="Senha">Senha</label>
            <input asp-for="Senha" type="password" placeholder="Digite sua senha" />
        </div>

        <a href="/web/registro" class="register-link">
            Não possui conta?
            <span>Crie sua conta aqui</span>
        </a>
        <button type="submit">Entrar</button>

    </form>
</div>