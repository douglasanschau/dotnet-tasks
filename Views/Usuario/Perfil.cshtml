@model  PerfilViewModel 


<link rel="stylesheet" href="/css/painel.css" asp-append-version="true"  />
<link rel="stylesheet" href="/css/perfil.css" asp-append-version="true"  />

<div class="dashboard">

    <aside class="sidebar">
        <h2>Tarefas .NET</h2>

        <nav>
            <a asp-controller="Usuario" asp-action="Painel">
              📋 Minhas Tarefas
            </a>

            <a asp-controller="Usuario" asp-action="Perfil">
                👤 Perfil
            </a>

            <a asp-controller="Usuario" asp-action="Logout">
                🚪 Sair
            </a>
        </nav>
    </aside>

    <main class="content">

        <div class="page-grid">

            <div class="profile-card">

                <div class="profile-header">
                    <h1>Meu Perfil</h1>
                    <p>
                        Atualize seus dados pessoais e mantenha sua conta segura.
                    </p>
                </div>

                <div asp-validation-summary="All" class="text-danger"></div>

                <form method="post"
                      asp-controller="Usuario"
                      asp-action="Perfil">

                    <input type="hidden" asp-for="Id">

                    <div class="form-group">
                        <label>Nome</label>
                        <input
                            type="text"
                            asp-for="Nome"
                            placeholder="Digite seu nome">
                    </div>

                    <div class="form-group">
                        <label>E-mail</label>
                        <input
                            type="email"
                            asp-for="Email"
                            placeholder="Digite seu e-mail">
                    </div>

                    <div class="form-group">
                        <label>Nova senha</label>
                        <input
                            type="password"
                            asp-for="Senha"
                            placeholder="Digite uma nova senha">
                    </div>

                    <div class="form-group">
                        <label>Confirmar senha</label>
                        <input
                            type="password"
                            asp-for="ConfirmarSenha"
                            placeholder="Confirme sua nova senha">
                    </div>

                    <div class="form-actions">
                        <button type="submit" class="btn-primary">
                            Salvar Alterações
                        </button>
                    </div>

                </form>

            </div>

            <div class="profile-info">

                <h3>Segurança da Conta</h3>

                <ul>
                    <li>Utilize uma senha forte.</li>
                    <li>Evite reutilizar senhas antigas.</li>
                    <li>Mantenha seu e-mail atualizado.</li>
                    <li>Altere sua senha periodicamente.</li>
                </ul>

                <div class="info-divider"></div>

                <h3>Dicas de Organização</h3>

                <ul>
                    <li>Revise suas tarefas diariamente.</li>
                    <li>Divida atividades grandes em etapas.</li>
                    <li>Atualize o status das tarefas concluídas.</li>
                    <li>Mantenha descrições objetivas.</li>
                </ul>

            </div>

        </div>

    </main>

</div>